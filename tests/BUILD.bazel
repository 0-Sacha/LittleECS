load("@rules_cc//cc:defs.bzl", "cc_test")

cc_test(
    name = "units",
    srcs = glob([ "**/*.h", "**/*.cpp" ], exclude=["Perf/**"]),
    includes = [ "src/" ],
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/std:c++20"],
        "//conditions:default": ["-std=c++20"],
    }),
    deps = [ "@streamformat//:StreamFormat", "//:lecs" ],
    visibility = ["//visibility:public"],
)

